PUBLIC_HOST=203.0.113.10
DEPLOY_MODE=ip_self_signed
REMOTE_API_PUBLIC_URL=https://203.0.113.10
REMOTE_SIGNAL_PUBLIC_URL=wss://203.0.113.10/ws
REMOTE_RELAY_PUBLIC_URL=203.0.113.10:18082
RELAY_PUBLIC_PORT=18082

POSTGRES_DB=remote_control
POSTGRES_USER=remote
POSTGRES_PASSWORD=replace-with-random-hex

REMOTE_SERVICE_TOKEN=replace-with-random-hex
REMOTE_TOKEN_SECRET=replace-with-random-hex
REMOTE_RELAY_TOKEN_SECRET=replace-with-random-hex
REMOTE_MFA_SECRET_KEY=replace-with-base64url-32-byte-key
REMOTE_RELAY_NODE_ID=relay-production-1

TLS_CERT_PATH=/opt/remote-control/certificates/server.crt
TLS_KEY_PATH=/opt/remote-control/certificates/server.key
CLIENT_CA_CERT_PATH=/opt/remote-control/certificates/root-ca.crt
LETSENCRYPT_EMAIL=
