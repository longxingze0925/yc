import { Button, CheckBox, LineEdit } from "std-widgets.slint";

global Theme {
    out property <color> canvas: #eef1f3;
    out property <color> surface: #ffffff;
    out property <color> sidebar: #f4f6f7;
    out property <color> border: #dce1e5;
    out property <color> text: #20262d;
    out property <color> muted: #6f7984;
    out property <color> faint: #929ba5;
    out property <color> accent: #3478df;
    out property <color> accent-soft: #e6effc;
    out property <color> success: #2f8a55;
    out property <color> success-soft: #eaf6ee;
    out property <color> warning: #9a6a13;
    out property <color> warning-soft: #fff7e5;
    out property <color> danger: #c63f3f;
    out property <color> danger-soft: #fff0f0;
}

export struct DeviceListItem {
    device-id: string,
    glyph: string,
    name: string,
    detail: string,
    state: string,
    online: bool,
    controlled: bool,
}

component Mark inherits Rectangle {
    in property <string> glyph;
    in property <color> fill: Theme.accent;
    width: 34px;
    height: 34px;
    border-radius: 7px;
    background: root.fill;

    Text {
        text: root.glyph;
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component StatusLabel inherits Rectangle {
    in property <string> label;
    in property <color> foreground: Theme.success;
    in property <color> fill: Theme.success-soft;
    min-width: 96px;
    height: 27px;
    border-radius: 6px;
    background: root.fill;

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 6px;
        alignment: center;
        Rectangle { width: 7px; height: 7px; border-radius: 4px; background: root.foreground; }
        Text { text: root.label; color: root.foreground; font-size: 11px; vertical-alignment: center; }
    }
}

component NavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <int> target-page;
    in property <bool> active;
    callback activated(int);
    height: 48px;
    border-radius: 6px;
    background: root.active ? #e1e7eb : nav-touch.has-hover ? #e9edf0 : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 10px;
        alignment: center;
        Rectangle {
            width: 31px;
            height: 31px;
            border-radius: 6px;
            background: root.active ? Theme.accent : Theme.accent-soft;
            Text {
                text: root.glyph;
                color: root.active ? #ffffff : Theme.accent;
                font-size: 10px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.label;
            color: root.active ? Theme.text : #4f5964;
            font-size: 14px;
            font-weight: root.active ? 650 : 520;
            vertical-alignment: center;
        }
    }
    nav-touch := TouchArea { clicked => { root.activated(root.target-page); } }
}

component DeviceRow inherits Rectangle {
    in property <string> glyph;
    in property <string> name;
    in property <string> detail;
    in property <string> state;
    in property <bool> local: false;
    in property <bool> online: true;
    callback open-session();
    height: 68px;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 7px;
    background: row-touch.has-hover ? #fafcfd : Theme.surface;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 14px;
        alignment: center;
        Mark { glyph: root.glyph; fill: root.online ? Theme.accent : #aab2ba; }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            Text { text: root.name + (root.local ? "  ·  本机" : ""); color: Theme.text; font-size: 15px; font-weight: 620; }
            Text { text: root.detail; color: Theme.muted; font-size: 11px; }
        }
        StatusLabel {
            label: root.state;
            foreground: root.online ? Theme.success : Theme.muted;
            fill: root.online ? Theme.success-soft : #edf0f2;
        }
        Button { text: root.local ? "查看状态" : "远程控制"; clicked => { root.open-session(); } }
    }
    row-touch := TouchArea { mouse-cursor: pointer; }
}

component SectionHeading inherits HorizontalLayout {
    in property <string> title;
    in property <string> meta;
    height: 38px;
    alignment: center;
    Text { text: root.title; color: Theme.text; font-size: 16px; font-weight: 650; }
    Rectangle { horizontal-stretch: 1; background: transparent; }
    Text { text: root.meta; color: Theme.muted; font-size: 12px; }
}

component LoginView inherits Rectangle {
    in property <string> platform-label;
    in property <string> login-status;
    in property <bool> mfa-required;
    in property <string> mfa-account;
    in property <int> mfa-attempts;
    in property <bool> mfa-allow-totp;
    in property <bool> mfa-allow-recovery;
    in property <bool> mfa-expired;
    property <int> selected-factor: root.mfa-allow-totp ? 0 : 1;
    callback submit(string, string);
    callback verify-mfa(int, string);
    callback cancel-mfa();
    background: Theme.surface;

    HorizontalLayout {
        Rectangle {
            width: 44%;
            background: #27343e;
            VerticalLayout {
                padding: 46px;
                spacing: 24px;
                HorizontalLayout {
                    height: 40px;
                    spacing: 12px;
                    Mark { glyph: "RC"; }
                    VerticalLayout {
                        spacing: 1px;
                        Text { text: "RC 远控"; color: #ffffff; font-size: 18px; font-weight: 700; }
                        Text { text: root.platform-label; color: #b7c1c9; font-size: 11px; }
                    }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Text { text: "这台电脑也是一台远控设备"; color: #ffffff; font-size: 25px; font-weight: 680; wrap: word-wrap; }
                Text {
                    text: "登录账号后，此设备会自动加入“我的设备”。完成系统授权后，可控制其他设备，也可接受远程连接。";
                    color: #c6ced5;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    spacing: 20px;
                    Text { text: "E2EE 业务通道"; color: #aeb9c1; font-size: 11px; }
                    Text { text: "P2P 优先"; color: #aeb9c1; font-size: 11px; }
                    Text { text: "可私有部署"; color: #aeb9c1; font-size: 11px; }
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.surface;
            VerticalLayout {
                padding-left: 86px;
                padding-right: 86px;
                alignment: center;
                if !root.mfa-required: Rectangle {
                    height: 430px;
                    VerticalLayout {
                        spacing: 13px;
                        Text { text: "登录账号"; color: Theme.text; font-size: 27px; font-weight: 700; }
                        Text { text: "登录后继续管理设备和远程协助"; color: Theme.muted; font-size: 13px; }
                        Rectangle { height: 10px; background: transparent; }
                        Text { text: "账号"; color: #505b66; font-size: 12px; font-weight: 620; }
                        account-input := LineEdit { height: 43px; text: "owner@example.com"; placeholder-text: "邮箱或手机号"; }
                        Text { text: "密码"; color: #505b66; font-size: 12px; font-weight: 620; }
                        password-input := LineEdit { height: 43px; placeholder-text: "输入密码"; input-type: password; }
                        CheckBox { text: "信任这台设备 30 天"; checked: true; }
                        Button {
                            height: 43px;
                            text: "登录并注册本机";
                            primary: true;
                            clicked => {
                                root.submit(account-input.text, password-input.text);
                                password-input.text = "";
                            }
                        }
                        Rectangle {
                            height: 44px;
                            border-width: 1px;
                            border-color: root.login-status == "" ? transparent : #ead49e;
                            border-radius: 7px;
                            background: root.login-status == "" ? transparent : Theme.warning-soft;
                            Text { text: root.login-status; color: Theme.warning; font-size: 11px; wrap: word-wrap; vertical-alignment: center; horizontal-alignment: center; }
                        }
                    }
                }
                if root.mfa-required: Rectangle {
                    height: 430px;
                    VerticalLayout {
                        spacing: 13px;
                        Text { text: "完成安全验证"; color: Theme.text; font-size: 27px; font-weight: 700; }
                        Text { text: root.mfa-account; color: Theme.muted; font-size: 13px; overflow: elide; }
                        Rectangle { height: 10px; background: transparent; }
                        Text { text: "验证方式"; color: #505b66; font-size: 12px; font-weight: 620; }
                        HorizontalLayout {
                            height: 42px;
                            spacing: 8px;
                            Button {
                                horizontal-stretch: 1;
                                text: "身份验证器";
                                enabled: root.mfa-allow-totp;
                                primary: root.selected-factor == 0;
                                clicked => { root.selected-factor = 0; }
                            }
                            Button {
                                horizontal-stretch: 1;
                                text: "恢复码";
                                enabled: root.mfa-allow-recovery;
                                primary: root.selected-factor == 1;
                                clicked => { root.selected-factor = 1; }
                            }
                        }
                        Text {
                            text: root.selected-factor == 0 ? "动态验证码" : "一次性恢复码";
                            color: #505b66;
                            font-size: 12px;
                            font-weight: 620;
                        }
                        mfa-code-input := LineEdit {
                            height: 43px;
                            placeholder-text: root.selected-factor == 0 ? "输入 6 位动态验证码" : "输入一次性恢复码";
                            input-type: password;
                            enabled: !root.mfa-expired;
                        }
                        Text {
                            text: root.mfa-expired ? "当前挑战已失效" : "剩余尝试次数：" + root.mfa-attempts;
                            color: root.mfa-expired ? Theme.danger : Theme.muted;
                            font-size: 11px;
                        }
                        HorizontalLayout {
                            height: 43px;
                            spacing: 8px;
                            Button {
                                horizontal-stretch: 1;
                                text: "取消";
                                clicked => {
                                    mfa-code-input.text = "";
                                    root.cancel-mfa();
                                }
                            }
                            Button {
                                horizontal-stretch: 1;
                                text: "验证并继续";
                                primary: true;
                                enabled: !root.mfa-expired
                                    && ((root.selected-factor == 0 && root.mfa-allow-totp)
                                        || (root.selected-factor == 1 && root.mfa-allow-recovery));
                                clicked => {
                                    root.verify-mfa(root.selected-factor, mfa-code-input.text);
                                    mfa-code-input.text = "";
                                }
                            }
                        }
                        Rectangle {
                            height: 52px;
                            border-width: 1px;
                            border-color: root.login-status == "" ? transparent : root.mfa-expired ? #efb8b8 : #ead49e;
                            border-radius: 7px;
                            background: root.login-status == "" ? transparent : root.mfa-expired ? Theme.danger-soft : Theme.warning-soft;
                            Text {
                                text: root.mfa-expired ? "验证已过期，请取消并重新登录" : root.login-status;
                                color: root.mfa-expired ? Theme.danger : Theme.warning;
                                font-size: 11px;
                                wrap: word-wrap;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

component DevicesPage inherits Rectangle {
    in property <string> local-device-name;
    in property <string> device-id;
    in property <string> registration-status;
    in property <string> capture-status;
    in property <string> input-status;
    in property <string> device-summary;
    in property <[DeviceListItem]> devices;
    callback navigate(int);
    callback open-session(string);
    background: Theme.canvas;

    VerticalLayout {
        padding: 28px;
        spacing: 9px;
        SectionHeading { title: "全部设备"; meta: root.device-summary; }
        Rectangle {
            height: 132px;
            border-width: 1px;
            border-color: #bcd0ea;
            border-radius: 8px;
            background: #f8fbff;
            HorizontalLayout {
                padding: 18px;
                spacing: 16px;
                alignment: center;
                Mark { glyph: "ME"; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 5px;
                    Text { text: root.local-device-name + "  ·  本机"; color: Theme.text; font-size: 17px; font-weight: 670; }
                    Text { text: "设备 ID：" + root.device-id + "  ·  controller + controlled"; color: Theme.muted; font-size: 12px; }
                    Text { text: root.registration-status; color: Theme.warning; font-size: 11px; }
                    Text { text: "屏幕采集：" + root.capture-status; color: Theme.muted; font-size: 10px; overflow: elide; }
                    Text { text: "输入控制：" + root.input-status; color: Theme.muted; font-size: 10px; overflow: elide; }
                }
                VerticalLayout {
                    width: 122px;
                    spacing: 8px;
                    StatusLabel { label: "本机已加入"; }
                    Button { text: "被控授权状态"; clicked => { root.navigate(3); } }
                }
            }
        }
        SectionHeading { title: "账号设备"; meta: root.devices.length + " 台"; }
        for item in root.devices: DeviceRow {
            glyph: item.glyph;
            name: item.name;
            detail: item.detail;
            state: item.state;
            online: item.online;
            open-session => { if item.controlled { root.open-session(item.device-id); } }
        }
    }
}

component AssistPage inherits Rectangle {
    in property <string> status;
    callback connect(string, string, bool);
    background: Theme.canvas;
    VerticalLayout {
        padding: 52px;
        alignment: start;
        Rectangle {
            height: 450px;
            VerticalLayout {
                spacing: 12px;
                Text { text: "远程协助"; color: Theme.text; font-size: 29px; font-weight: 700; }
                Text { text: "输入对方设备 ID 和本次临时验证码。"; color: Theme.muted; font-size: 13px; }
                Rectangle { height: 12px; background: transparent; }
                Rectangle {
                    height: 280px;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 8px;
                    background: Theme.surface;
                    VerticalLayout {
                        padding: 26px;
                        spacing: 10px;
                        Text { text: "连接伙伴设备"; color: Theme.text; font-size: 18px; font-weight: 650; }
                        Text { text: "陌生账号协助必须确认对方身份与风险。"; color: Theme.muted; font-size: 12px; }
                        HorizontalLayout {
                            height: 45px;
                            spacing: 10px;
                            device-input := LineEdit { horizontal-stretch: 1; placeholder-text: "对方设备 ID"; }
                            code-input := LineEdit { width: 190px; placeholder-text: "6 位临时验证码"; }
                        }
                        risk-check := CheckBox { text: "我已确认对方身份，并了解远程控制风险"; }
                        Button { height: 42px; text: "确认并发起连接"; primary: true; clicked => { root.connect(device-input.text, code-input.text, risk-check.checked); } }
                        Rectangle {
                            height: 48px;
                            border-width: 1px;
                            border-color: #ead49e;
                            border-radius: 7px;
                            background: Theme.warning-soft;
                            Text { text: root.status; color: Theme.warning; font-size: 11px; wrap: word-wrap; vertical-alignment: center; horizontal-alignment: center; }
                        }
                    }
                }
            }
        }
    }
}

component ServerPage inherits Rectangle {
    in property <string> status;
    in property <string> api-url;
    in property <string> signal-url;
    in property <string> relay-url;
    in property <string> server-key-fingerprint;
    callback test(string, string, string, string);
    callback save(string, string, string, string);
    background: Theme.canvas;
    VerticalLayout {
        padding: 28px;
        spacing: 12px;
        SectionHeading { title: "自建服务器"; meta: "配置 API、Signal 和 Relay"; }
        Rectangle {
            height: 530px;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;
            background: Theme.surface;
            VerticalLayout {
                padding: 24px;
                spacing: 8px;
                Text { text: "连接配置"; color: Theme.text; font-size: 18px; font-weight: 650; }
                Text { text: "服务器公钥必须从可信渠道核对；自建服务器仍不能解密远控业务内容。"; color: Theme.muted; font-size: 12px; }
                Text { text: "API 地址"; color: #505b66; font-size: 12px; }
                api-input := LineEdit { height: 40px; text: root.api-url; placeholder-text: "https://api.example.com"; }
                Text { text: "Signal 地址"; color: #505b66; font-size: 12px; }
                signal-input := LineEdit { height: 40px; text: root.signal-url; placeholder-text: "wss://signal.example.com"; }
                Text { text: "Relay 地址"; color: #505b66; font-size: 12px; }
                relay-input := LineEdit { height: 40px; text: root.relay-url; placeholder-text: "relay.example.com:443"; }
                Text { text: "服务器公钥 / 指纹"; color: #505b66; font-size: 12px; }
                key-input := LineEdit { height: 40px; text: root.server-key-fingerprint; placeholder-text: "粘贴可信公钥或指纹"; }
                HorizontalLayout {
                    height: 42px;
                    alignment: end;
                    Text { horizontal-stretch: 1; text: root.status; color: Theme.warning; font-size: 11px; vertical-alignment: center; }
                    Button { text: "测试连接"; clicked => { root.test(api-input.text, signal-input.text, relay-input.text, key-input.text); } }
                    Button { text: "保存配置"; primary: true; clicked => { root.save(api-input.text, signal-input.text, relay-input.text, key-input.text); } }
                }
            }
        }
    }
}

component PermissionLine inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <string> state;
    in property <bool> active: false;
    height: 54px;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 12px;
        alignment: center;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: root.name; color: Theme.text; font-size: 13px; font-weight: 620; }
            Text { text: root.detail; color: Theme.muted; font-size: 10px; overflow: elide; }
        }
        StatusLabel {
            label: root.state;
            foreground: root.active ? Theme.success : Theme.warning;
            fill: root.active ? Theme.success-soft : Theme.warning-soft;
        }
    }
    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: #e8ebee; }
}

component ControlledPage inherits Rectangle {
    in property <string> privacy-status;
    in property <string> capture-status;
    in property <string> input-status;
    in property <string> session-status;
    in property <bool> allow-account-remote;
    in property <bool> capture-available;
    in property <bool> input-available;
    in property <bool> controlled-active;
    callback set-allow-account-remote(bool);
    callback disconnect();
    background: Theme.canvas;
    VerticalLayout {
        padding: 28px;
        spacing: 12px;
        HorizontalLayout {
            height: 48px;
            Text { text: "本机被控授权与状态"; color: Theme.text; font-size: 24px; font-weight: 700; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Button { text: "立即断开"; enabled: root.controlled-active; clicked => { root.disconnect(); } }
        }
        Rectangle {
            height: 58px;
            border-width: 1px;
            border-color: #b8d9c4;
            border-radius: 8px;
            background: Theme.success-soft;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                alignment: center;
                StatusLabel { label: root.controlled-active ? "控制中" : "等待连接"; }
                Text {
                    text: root.session-status == ""
                        ? "本机已就绪，等待同账号设备连接。"
                        : root.session-status;
                    color: #3f694e;
                    font-size: 12px;
                    overflow: elide;
                }
            }
        }
        SectionHeading { title: "被控能力"; meta: "敏感能力默认关闭"; }
        Rectangle {
            height: 320px;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;
            background: Theme.surface;
            VerticalLayout {
                padding: 18px;
                spacing: 4px;
                Rectangle {
                    height: 62px;
                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 12px;
                        alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: "允许我的设备远程访问"; color: Theme.text; font-size: 13px; font-weight: 620; }
                            Text { text: "开启后，同账号设备的一键连接不再逐次确认"; color: Theme.muted; font-size: 10px; }
                        }
                        allow-account := CheckBox {
                            checked: root.allow-account-remote;
                            toggled => { root.set-allow-account-remote(self.checked); }
                        }
                    }
                    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: #e8ebee; }
                }
                PermissionLine {
                    name: "屏幕查看";
                    detail: root.capture-status;
                    state: root.capture-available ? "已接入" : "不可用";
                    active: root.capture-available;
                }
                PermissionLine {
                    name: "鼠标与键盘";
                    detail: root.input-status;
                    state: root.input-available ? "已接入" : "不可用";
                    active: root.input-available;
                }
                PermissionLine { name: "剪贴板 / 文件传输"; detail: "独立授权，不保存内容到日志"; state: "默认关闭"; }
                PermissionLine { name: "隐私屏 / 本地输入保护"; detail: root.privacy-status; state: "unsupported"; }
            }
        }
    }
}

component SessionPage inherits Rectangle {
    in property <string> status;
    in property <string> render-status;
    callback disconnect();
    background: #e7eaed;
    VerticalLayout {
        Rectangle {
            height: 54px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                alignment: center;
                Mark { glyph: "PC"; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text { text: "设计部 Windows"; color: Theme.text; font-size: 14px; font-weight: 650; }
                    Text { text: "会话壳层 · 未建立 E2EE 业务通道"; color: Theme.muted; font-size: 10px; }
                }
                Text { text: "路径 --  ·  RTT --  ·  FPS --"; color: Theme.muted; font-size: 11px; }
            }
            Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
        }
        Rectangle {
            vertical-stretch: 1;
            background: #dfe3e7;
            Rectangle {
                x: 24px;
                y: 70px;
                width: parent.width - 48px;
                height: parent.height - 94px;
                border-width: 1px;
                border-color: #aab2ba;
                border-radius: 5px;
                background: #1d2329;
                VerticalLayout {
                    padding: 40px;
                    alignment: center;
                    spacing: 10px;
                    Text { text: "原生远控渲染区"; color: #eef1f3; font-size: 22px; font-weight: 650; horizontal-alignment: center; }
                    Text { text: root.render-status; color: #b5bec6; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                    Text { text: root.status; color: #e3c06e; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                }
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 12px;
                width: 500px;
                height: 46px;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 8px;
                background: #ffffffee;
                HorizontalLayout {
                    padding: 5px;
                    spacing: 5px;
                    Button { text: "显示器"; }
                    Button { text: "文本优先"; }
                    Button { text: "平衡画质"; }
                    Button { text: "更多操作"; }
                    Button { text: "断开"; clicked => { root.disconnect(); } }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "RC 远控";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 960px;
    min-height: 640px;
    background: Theme.canvas;

    in-out property <bool> logged-in: false;
    in-out property <int> page: 0;
    in-out property <string> platform-label: "Desktop";
    in-out property <string> session-kind: "unknown";
    in-out property <string> account-label: "";
    in-out property <string> local-device-name: "Desktop";
    in-out property <string> local-device-id: "待服务端分配";
    in-out property <string> registration-status: "";
    in-out property <string> capture-status: "unsupported";
    in-out property <string> render-status: "unsupported";
    in-out property <string> input-status: "unsupported";
    in-out property <string> privacy-status: "unsupported";
    in-out property <string> login-status: "";
    in-out property <bool> mfa-required: false;
    in-out property <string> mfa-account: "";
    in-out property <int> mfa-attempts: 0;
    in-out property <bool> mfa-allow-totp: false;
    in-out property <bool> mfa-allow-recovery: false;
    in-out property <bool> mfa-expired: false;
    in-out property <string> assist-status: "";
    in-out property <string> server-status: "";
    in-out property <string> session-status: "";
    in-out property <string> environment-label: "未配置服务";
    in-out property <string> signal-status: "Signal 未连接";
    in-out property <string> api-url: "";
    in-out property <string> signal-url: "";
    in-out property <string> relay-url: "";
    in-out property <string> server-key-fingerprint: "";
    in-out property <string> device-summary: "0 台账号设备";
    in-out property <bool> allow-account-remote: false;
    in-out property <bool> capture-available: false;
    in-out property <bool> input-available: false;
    in-out property <bool> controlled-active: false;
    in-out property <[DeviceListItem]> devices: [];

    callback login(string, string);
    callback verify-mfa(int, string);
    callback cancel-mfa();
    callback navigate(int);
    callback connect-assist(string, string, bool);
    callback test-server(string, string, string, string);
    callback save-server(string, string, string, string);
    callback open-session(string);
    callback disconnect();
    callback set-allow-account-remote(bool);

    if !root.logged-in: LoginView {
        platform-label: root.platform-label;
        login-status: root.login-status;
        mfa-required: root.mfa-required;
        mfa-account: root.mfa-account;
        mfa-attempts: root.mfa-attempts;
        mfa-allow-totp: root.mfa-allow-totp;
        mfa-allow-recovery: root.mfa-allow-recovery;
        mfa-expired: root.mfa-expired;
        submit(account, password) => { root.login(account, password); }
        verify-mfa(factor, code) => { root.verify-mfa(factor, code); }
        cancel-mfa => { root.cancel-mfa(); }
    }

    if root.logged-in: Rectangle {
        background: Theme.canvas;
        VerticalLayout {
            Rectangle {
                height: 55px;
                background: #f8f9fa;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 11px;
                    alignment: center;
                    Mark { glyph: "RC"; }
                    Text { text: "RC 远控"; color: Theme.text; font-size: 17px; font-weight: 700; }
                    Rectangle { width: 1px; height: 25px; background: Theme.border; }
                    Text { text: root.platform-label; color: Theme.muted; font-size: 12px; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    StatusLabel { label: root.environment-label; foreground: Theme.warning; fill: Theme.warning-soft; }
                    Text { text: root.account-label; color: Theme.muted; font-size: 12px; }
                }
                Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
            }
            HorizontalLayout {
                Rectangle {
                    width: 250px;
                    background: Theme.sidebar;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        Text { text: "工作台"; color: Theme.faint; font-size: 11px; font-weight: 650; }
                        NavItem { glyph: "DE"; label: "我的设备"; target-page: 0; active: root.page == 0; activated(page) => { root.navigate(page); } }
                        Rectangle { height: 12px; background: transparent; }
                        Text { text: "设备与环境"; color: Theme.faint; font-size: 11px; font-weight: 650; }
                        NavItem { glyph: "CT"; label: "被控授权状态"; target-page: 3; active: root.page == 3; activated(page) => { root.navigate(page); } }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        Rectangle { height: 1px; background: Theme.border; }
                        Rectangle {
                            height: 72px;
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: center;
                                Mark { glyph: "ME"; fill: #50627d; }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text { text: root.local-device-name; color: Theme.text; font-size: 12px; font-weight: 620; overflow: elide; }
                                    Text { text: root.session-kind + " · controller + controlled"; color: Theme.muted; font-size: 9px; overflow: elide; }
                                }
                            }
                        }
                    }
                    Rectangle { x: parent.width - 1px; y: 0px; width: 1px; height: parent.height; background: Theme.border; }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.canvas;
                    if root.page == 0: DevicesPage {
                        local-device-name: root.local-device-name;
                        device-id: root.local-device-id;
                        registration-status: root.registration-status;
                        capture-status: root.capture-status;
                        input-status: root.input-status;
                        device-summary: root.device-summary;
                        devices: root.devices;
                        navigate(page) => {
                            root.navigate(page);
                        }
                        open-session(device-id) => { root.open-session(device-id); }
                    }
                    if root.page == 1: AssistPage { status: root.assist-status; connect(id, code, confirmed) => { root.connect-assist(id, code, confirmed); } }
                    if root.page == 2: ServerPage {
                        status: root.server-status;
                        api-url: root.api-url;
                        signal-url: root.signal-url;
                        relay-url: root.relay-url;
                        server-key-fingerprint: root.server-key-fingerprint;
                        test(api, signal, relay, key) => { root.test-server(api, signal, relay, key); }
                        save(api, signal, relay, key) => { root.save-server(api, signal, relay, key); }
                    }
                    if root.page == 3: ControlledPage {
                        privacy-status: root.privacy-status;
                        capture-status: root.capture-status;
                        input-status: root.input-status;
                        session-status: root.session-status;
                        allow-account-remote: root.allow-account-remote;
                        capture-available: root.capture-available;
                        input-available: root.input-available;
                        controlled-active: root.controlled-active;
                        set-allow-account-remote(value) => { root.set-allow-account-remote(value); }
                        disconnect => { root.disconnect(); }
                    }
                    if root.page == 4: SessionPage { status: root.session-status; render-status: root.render-status; disconnect => { root.disconnect(); } }
                }
            }
            Rectangle {
                height: 30px;
                background: #f7f8f9;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 18px;
                    alignment: center;
                    Text { text: root.signal-status; color: Theme.warning; font-size: 10px; }
                    Text { text: root.session-kind; color: Theme.muted; font-size: 10px; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: "客户端 0.1.0"; color: Theme.muted; font-size: 10px; }
                }
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.border; }
            }
        }
    }
}
